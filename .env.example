# Copy this file to ".env" and fill it in.

# Local MongoDB:      mongodb://127.0.0.1:27017
# MongoDB Atlas:      mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=livora

PORT=3000

# Password you type on the login screen. Use something long.
ADMIN_PASSWORD=change-this-password

# Any long random text. Used to sign login sessions.
SESSION_SECRET=change-this-to-a-long-random-text

# Hours a login stays valid
SESSION_HOURS=72
